<Page
    x:Class="Nexus.UI.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nexus.UI.Controls"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:vm="using:Nexus.UI.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="22,14,22,22" Spacing="12">

            <!-- Header & Strip Perangkat Keras -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock Text="Ringkasan Sistem" Style="{StaticResource NexusPageTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ProcessServiceSummary, Mode=OneWay}" Style="{StaticResource NexusCaptionStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Text="{x:Bind ViewModel.HardwareSummaryLine, Mode=OneWay}"
                        Style="{StaticResource NexusCaptionStyle}"
                        HorizontalAlignment="Right"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}"
                        Style="{StaticResource NexusMutedCaptionStyle}"
                        HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <!-- Banner Kesehatan & Batas Target -->
            <Border Style="{StaticResource NexusCardBorderStyle}" Padding="14,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="10" Height="10" Fill="{x:Bind ViewModel.HealthBadgeBrush, Mode=OneWay}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.HealthHeadline, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource NexusTextPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.HealthDetail, Mode=OneWay}" Style="{StaticResource NexusCaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{ThemeResource NexusAccentSubtleBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ProfileBadgeText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource NexusAccentBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- 4 Kartu Ringkasan KPI -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:MetricRingCard
                    Grid.Column="0"
                    Label="CPU"
                    Glyph="&#xE950;"
                    PrimaryValue="{x:Bind ViewModel.CpuPrimaryText, Mode=OneWay}"
                    SecondaryValue="{x:Bind ViewModel.CpuSecondaryText, Mode=OneWay}"
                    BadgeText="{x:Bind ViewModel.CpuBadgeText, Mode=OneWay}"
                    Percentage="{x:Bind ViewModel.CpuPercent, Mode=OneWay}"
                    AccentBrush="{x:Bind ViewModel.CpuAccentBrush, Mode=OneWay}" />

                <controls:MetricRingCard
                    Grid.Column="1"
                    Label="MEMORI (RAM)"
                    Glyph="&#xE7F4;"
                    PrimaryValue="{x:Bind ViewModel.RamPrimaryText, Mode=OneWay}"
                    SecondaryValue="{x:Bind ViewModel.RamSecondaryText, Mode=OneWay}"
                    BadgeText="{x:Bind ViewModel.RamBadgeText, Mode=OneWay}"
                    Percentage="{x:Bind ViewModel.RamPercent, Mode=OneWay}"
                    AccentBrush="{x:Bind ViewModel.RamAccentBrush, Mode=OneWay}" />

                <controls:MetricRingCard
                    Grid.Column="2"
                    Label="MEMORI KOMIT"
                    Glyph="&#xE8B7;"
                    PrimaryValue="{x:Bind ViewModel.CommitPrimaryText, Mode=OneWay}"
                    SecondaryValue="{x:Bind ViewModel.CommitSecondaryText, Mode=OneWay}"
                    BadgeText="{x:Bind ViewModel.CommitBadgeText, Mode=OneWay}"
                    Percentage="{x:Bind ViewModel.CommitPercent, Mode=OneWay}"
                    AccentBrush="{x:Bind ViewModel.CommitAccentBrush, Mode=OneWay}" />

                <controls:MetricRingCard
                    Grid.Column="3"
                    Label="DISK &amp; JARINGAN"
                    Glyph="&#xEDA2;"
                    PrimaryValue="{x:Bind ViewModel.DiskPrimaryText, Mode=OneWay}"
                    SecondaryValue="{x:Bind ViewModel.DiskSecondaryText, Mode=OneWay}"
                    BadgeText="{x:Bind ViewModel.DiskBadgeText, Mode=OneWay}"
                    Percentage="{x:Bind ViewModel.DiskUsagePercent, Mode=OneWay}"
                    AccentBrush="{x:Bind ViewModel.DiskAccentBrush, Mode=OneWay}" />
            </Grid>

            <!-- Baris Grafik Utama: Penggunaan CPU + Thread Per-Core -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource NexusCardBorderStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="200" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Penggunaan CPU" Style="{StaticResource NexusCardTitleStyle}" />
                                <TextBlock Text="(Garis batas target CPU)" Style="{StaticResource NexusMutedCaptionStyle}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Rentang:" Style="{StaticResource NexusMutedCaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Button Content="1m" Style="{StaticResource NexusZoomButtonStyle}" Command="{x:Bind ViewModel.SetZoomWindowCommand}" CommandParameter="1m" />
                                <Button Content="5m" Style="{StaticResource NexusZoomButtonStyle}" Command="{x:Bind ViewModel.SetZoomWindowCommand}" CommandParameter="5m" />
                                <Button Content="30m" Style="{StaticResource NexusZoomButtonStyle}" Command="{x:Bind ViewModel.SetZoomWindowCommand}" CommandParameter="30m" />
                                <Button Content="Semua" Style="{StaticResource NexusZoomButtonStyle}" Command="{x:Bind ViewModel.SetZoomWindowCommand}" CommandParameter="All" />
                            </StackPanel>
                        </Grid>

                        <lvc:CartesianChart
                            Grid.Row="1"
                            Series="{x:Bind ViewModel.CpuSeries}"
                            XAxes="{x:Bind ViewModel.HiddenXAxes}"
                            YAxes="{x:Bind ViewModel.CpuYAxes}"
                            Sections="{x:Bind ViewModel.CpuThresholdSections}"
                            AnimationsSpeed="00:00:00.15" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource NexusCardBorderStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="200" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Beban Per-Core CPU" Style="{StaticResource NexusCardTitleStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="Real-Time %" Style="{StaticResource NexusMutedCaptionStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <lvc:CartesianChart
                            Grid.Row="1"
                            Series="{x:Bind ViewModel.CoreBarSeries}"
                            XAxes="{x:Bind ViewModel.CoreXAxes}"
                            YAxes="{x:Bind ViewModel.CoreYAxes}"
                            AnimationsSpeed="00:00:00.12" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Baris Grafik Kedua: RAM + Disk & Jaringan -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource NexusCardBorderStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="175" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Penggunaan RAM" Style="{StaticResource NexusCardTitleStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RamPrimaryText, Mode=OneWay}" Style="{StaticResource NexusCaptionStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <lvc:CartesianChart
                            Grid.Row="1"
                            Series="{x:Bind ViewModel.RamSeries}"
                            XAxes="{x:Bind ViewModel.HiddenXAxes}"
                            YAxes="{x:Bind ViewModel.RamYAxes}"
                            Sections="{x:Bind ViewModel.RamThresholdSections}"
                            AnimationsSpeed="00:00:00.15" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource NexusCardBorderStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="175" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="2">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Aktivitas Disk &amp; Jaringan" Style="{StaticResource NexusCardTitleStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NetworkSummaryText, Mode=OneWay}" Style="{StaticResource NexusMutedCaptionStyle}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.DiskThroughputText, Mode=OneWay}" Style="{StaticResource NexusMutedCaptionStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <lvc:CartesianChart
                            Grid.Row="1"
                            Series="{x:Bind ViewModel.ActivitySeries}"
                            XAxes="{x:Bind ViewModel.HiddenXAxes}"
                            YAxes="{x:Bind ViewModel.ActivityYAxes}"
                            AnimationsSpeed="00:00:00.15" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Aplikasi Konsumsi Tertinggi -->
            <Border Style="{StaticResource NexusCardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Aplikasi dengan Konsumsi Tertinggi (Dikelompokkan Otomatis)" Style="{StaticResource NexusCardTitleStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="Urut RAM Privat · Multi-proses digabung otomatis" Style="{StaticResource NexusMutedCaptionStyle}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Padding="8,6" Background="{ThemeResource NexusCardElevatedBrush}" CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Aplikasi" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Nama Proses" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Jumlah" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="RAM Privat" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="CPU %" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Proteksi" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.TopProcesses}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:TopProcessRow">
                                <Grid Padding="8,7" BorderBrush="{ThemeResource NexusDividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" FontSize="13" FontWeight="Medium" Foreground="{ThemeResource NexusTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ProcessName}" Style="{StaticResource NexusCaptionStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind InstanceBadge}" Style="{StaticResource NexusMutedCaptionStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind MemoryFormatted}" Style="{StaticResource NexusCaptionStyle}" Foreground="{ThemeResource NexusTextPrimaryBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind CpuFormatted}" Style="{StaticResource NexusCaptionStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ProtectionBadge}" Style="{StaticResource NexusMutedCaptionStyle}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
