<Page
    x:Class="Nexus.UI.Views.ServiceManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Nexus.UI.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="22,14,22,18" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Manajer Layanan Windows (Service Manager)" Style="{StaticResource NexusPageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource NexusCaptionStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Segarkan Layanan" VerticalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <!-- Bar Pencarian & Filter -->
        <Border Grid.Row="1" Style="{StaticResource NexusCardBorderStyle}" Padding="12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    PlaceholderText="Cari layanan (mis. Chrome, gupdate, SQL)..."
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.SelectedStatusFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="Semua Status" />
                    <ComboBoxItem Content="Berjalan" />
                    <ComboBoxItem Content="Berhenti" />
                </ComboBox>

                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="Semua Kategori" />
                    <ComboBoxItem Content="Kandidat Optimasi Aman" />
                    <ComboBoxItem Content="Aplikasi Pengguna" />
                    <ComboBoxItem Content="Pengembangan (Dev)" />
                    <ComboBoxItem Content="Kritis / Dilindungi" />
                </ComboBox>

                <TextBlock
                    Grid.Column="3"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Foreground="{ThemeResource NexusAccentBrush}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Tabel Layanan + Panel Detail & Kontrol -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource NexusCardBorderStyle}" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="8,6" Background="{ThemeResource NexusCardElevatedBrush}" CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.6*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Layanan" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Startup" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Kategori" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="PID" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Services}"
                        SelectedItem="{x:Bind ViewModel.SelectedService, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceDisplayRow">
                                <Grid Padding="8,6" BorderBrush="{ThemeResource NexusDividerBrush}" BorderThickness="0,0,0,1" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="0.6*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="Medium" Foreground="{ThemeResource NexusTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ServiceName}" Style="{StaticResource NexusMutedCaptionStyle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind StateText}" VerticalAlignment="Center" Style="{StaticResource NexusCaptionStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind StartupText}" VerticalAlignment="Center" Style="{StaticResource NexusMutedCaptionStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind CategoryText}" VerticalAlignment="Center" Style="{StaticResource NexusCaptionStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind PidText}" VerticalAlignment="Center" Style="{StaticResource NexusMutedCaptionStyle}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Panel Detail, Dependensi & Aksi Aman -->
            <Border Grid.Column="1" Style="{StaticResource NexusCardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Detail &amp; Kontrol Layanan" Style="{StaticResource NexusCardTitleStyle}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.SelectedService.DisplayName, Mode=OneWay, FallbackValue='Pilih salah satu layanan di tabel'}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource NexusTextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedService.RecommendationText, Mode=OneWay, FallbackValue='—'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource NexusAccentBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedService.Raw.Description, Mode=OneWay, FallbackValue='Klik layanan untuk melihat deskripsi, dependensi, dan opsi optimasi aman.'}" Style="{StaticResource NexusCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{ThemeResource NexusCardElevatedBrush}" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Bergantung Pada (Dependencies):" Style="{StaticResource NexusMutedCaptionStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedDependenciesText, Mode=OneWay}" Style="{StaticResource NexusCaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="Layanan yang Bergantung ke Ini:" Style="{StaticResource NexusMutedCaptionStyle}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedDependentsText, Mode=OneWay}" Style="{StaticResource NexusCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Kontrol Status -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Kontrol Layanan (Snapshot Otomatis ke SQLite)" Style="{StaticResource NexusMutedCaptionStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Jalankan" Click="Start_Click" />
                                <Button Content="Hentikan" Click="Stop_Click" />
                                <Button Content="Mulai Ulang" Click="Restart_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Kontrol Tipe Startup -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Ubah Tipe Startup Aman" Style="{StaticResource NexusMutedCaptionStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Manual" Click="SetManual_Click" />
                                <Button Content="Otomatis" Click="SetAuto_Click" />
                                <Button Content="Rollback 1-Klik" Click="Rollback_Click" />
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{ThemeResource NexusWarningSubtleBrush}" CornerRadius="6" Padding="10">
                            <TextBlock
                                Text="Keamanan: Layanan inti Windows (Defender, RPC, PnP, DHCP, DNS, Audio, Update, Auth, Storage) dikunci permanen dan tidak bisa dimatikan. Mengubah layanan Windows memerlukan hak Administrator."
                                Style="{StaticResource NexusMutedCaptionStyle}"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>

