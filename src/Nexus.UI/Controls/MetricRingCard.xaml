<UserControl
    x:Class="Nexus.UI.Controls.MetricRingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource NexusCardBorderStyle}" Padding="14,12">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Radial Ring Gauge -->
            <Grid Width="48" Height="48" VerticalAlignment="Center">
                <Ellipse
                    Width="44"
                    Height="44"
                    Stroke="{ThemeResource NexusRingTrackBrush}"
                    StrokeThickness="4" />

                <Path
                    x:Name="ArcPath"
                    Width="48"
                    Height="48"
                    Stroke="{x:Bind AccentBrush, Mode=OneWay}"
                    StrokeThickness="4"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />

                <FontIcon
                    Glyph="{x:Bind Glyph, Mode=OneWay}"
                    FontSize="14"
                    Foreground="{x:Bind AccentBrush, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Labels & Tabular Metric -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind Label, Mode=OneWay}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        CharacterSpacing="40"
                        Foreground="{ThemeResource NexusTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind BadgeText, Mode=OneWay}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind AccentBrush, Mode=OneWay}"
                        Typography.NumeralAlignment="Tabular" />
                </Grid>

                <TextBlock
                    Text="{x:Bind PrimaryValue, Mode=OneWay}"
                    Style="{StaticResource NexusKpiValueStyle}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    Text="{x:Bind SecondaryValue, Mode=OneWay}"
                    Style="{StaticResource NexusMutedCaptionStyle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
