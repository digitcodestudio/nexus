<Window
    x:Class="Nexus.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="NEXUS System Optimizer">

    <Grid x:Name="RootContainer" Background="{ThemeResource NexusWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- System Tray Icon (Tetap Berjalan di Latar Belakang) -->
        <tb:TaskbarIcon
            x:Name="NexusTrayIcon"
            ToolTipText="{x:Bind ViewModel.TrayTooltipText, Mode=OneWay}"
            NoLeftClickDelay="True"
            LeftClickCommand="{x:Bind ShowWindowCommand}"
            DoubleClickCommand="{x:Bind ShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Buka NEXUS System Optimizer" Click="TrayOpen_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="Ganti Profil Optimasi">
                        <MenuFlyoutItem Text="Seimbang (RAM ≤ 75%, CPU ≤ 65%)" Click="TrayProfileBalanced_Click" />
                        <MenuFlyoutItem Text="Pengembangan (Developer)" Click="TrayProfileDev_Click" />
                        <MenuFlyoutItem Text="Beban Berat" Click="TrayProfileHeavy_Click" />
                        <MenuFlyoutItem Text="Hemat Daya" Click="TrayProfilePower_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem Text="STOP DARURAT Otomatisasi" Click="TrayEmergencyStop_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Keluar Sepenuhnya" Click="TrayExit_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- Baris 0: Custom Fluent Title Bar dengan Logo icon.ico -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,0,150,0" Background="{ThemeResource NexusSidebarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Image
                    x:Name="BrandLogoImage"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="NEXUS System Optimizer"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource NexusTextPrimaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <Border
                Grid.Column="2"
                Background="{ThemeResource NexusCardBackgroundBrush}"
                BorderBrush="{ThemeResource NexusCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="11"
                Padding="10,3"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" Fill="{ThemeResource NexusSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveProfileName, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource NexusTextPrimaryBrush}" />
                    <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource NexusTextMutedBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.AutomationStatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource NexusTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Baris 1: Fluent Ribbon Menu (Tab Bar + Baris Perintah Kontekstual) -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource NexusSidebarBackgroundBrush}"
            BorderBrush="{ThemeResource NexusCardBorderBrush}"
            BorderThickness="0,1,0,1">
            <StackPanel>

                <!-- Strip Tab Ribbon (10 Menu Lengkap) -->
                <Grid Padding="12,4,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RibbonTabsPanel" Orientation="Horizontal" Spacing="2">
                            <Button Tag="Overview" Content="Ringkasan" Style="{StaticResource NexusRibbonTabButtonStyle}" Click="RibbonTab_Click" />
                            <Button Tag="Performance" Content="Performa" Style="{StaticResource NexusRibbonTabButtonStyle}" Click="RibbonTab_Click" />
                            <Button Tag="MemoryOptimizer" Content="Optimasi RAM" Style="{StaticResource NexusRibbonTabButtonStyle}" Click="RibbonTab_Click" />
                            <Button Tag="CpuOptimizer" Content="Optimasi CPU" Style="{StaticResource NexusRibbonTabButtonStyle}" Click="RibbonTab_Click" />
                            <Button Tag="ProcessManager" Content="Manajer Proses" Style="{StaticResource NexusRibbonTabButtonStyle}" Click="RibbonTab_Click" />
                            <Button Tag="ServiceManager" Content="Layanan Windows" Style="{StaticResource NexusRibbonTabButtonStyle}" Click="RibbonTab_Click" />
                            <Button Tag="SmartAutomation" Content="Otomatisasi" Style="{StaticResource NexusRibbonTabButtonStyle}" Click="RibbonTab_Click" />
                            <Button Tag="OptimizationProfiles" Content="Profil" Style="{StaticResource NexusRibbonTabButtonStyle}" Click="RibbonTab_Click" />
                            <Button Tag="ActivityHistory" Content="Riwayat" Style="{StaticResource NexusRibbonTabButtonStyle}" Click="RibbonTab_Click" />
                            <Button Tag="Settings" Content="Pengaturan" Style="{StaticResource NexusRibbonTabButtonStyle}" Click="RibbonTab_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <Button
                        Grid.Column="1"
                        Style="{StaticResource NexusZoomButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleRibbonCommand}"
                        ToolTipService.ToolTip="Lipat / Bentangkan Pita Perintah Ribbon">
                        <FontIcon Glyph="&#xE70D;" FontSize="11" />
                    </Button>
                </Grid>

                <!-- Pita Perintah Cepat (Ribbon Command Bar) -->
                <Border
                    x:Name="RibbonCommandStrip"
                    Visibility="{x:Bind ViewModel.IsRibbonExpanded, Mode=OneWay}"
                    Background="{ThemeResource NexusCardBackgroundBrush}"
                    BorderBrush="{ThemeResource NexusDividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,7">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Grup 1: Aksi Cepat -->
                        <StackPanel Grid.Column="0" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Style="{StaticResource NexusRibbonCommandButtonStyle}" Command="{x:Bind ViewModel.RequestRefreshCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                        <TextBlock Text="Segarkan" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NexusRibbonCommandButtonStyle}" Command="{x:Bind ViewModel.RunQuickAnalysisCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="{ThemeResource NexusAccentBrush}" />
                                        <TextBlock Text="Analisa Sistem" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NexusRibbonCommandButtonStyle}" Command="{x:Bind ViewModel.CleanTrayNowCommand}" ToolTipService.ToolTip="Bersihkan ikon tray hantu &amp; duplikat aplikasi (mis. Telegram ganda)">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xEA99;" FontSize="11" Foreground="{ThemeResource NexusAccentBrush}" />
                                        <TextBlock Text="Bersihkan Tray" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NexusRibbonCommandButtonStyle}" Command="{x:Bind ViewModel.ToggleSafeModeCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{ThemeResource NexusSuccessBrush}" />
                                        <TextBlock Text="Mode Aman" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NexusRibbonCommandButtonStyle}" Command="{x:Bind ViewModel.EmergencyStopCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE71A;" FontSize="11" Foreground="{ThemeResource NexusCriticalBrush}" />
                                        <TextBlock Text="Stop Darurat" Foreground="{ThemeResource NexusCriticalBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="AKSI CEPAT" FontSize="9" Foreground="{ThemeResource NexusTextMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="{ThemeResource NexusCardBorderBrush}" Margin="0,2" />

                        <!-- Grup 2: Profil Cepat -->
                        <StackPanel Grid.Column="2" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Button Content="Seimbang" Style="{StaticResource NexusRibbonCommandButtonStyle}" Command="{x:Bind ViewModel.SwitchProfileCommand}" CommandParameter="Balanced" />
                                <Button Content="Pengembangan" Style="{StaticResource NexusRibbonCommandButtonStyle}" Command="{x:Bind ViewModel.SwitchProfileCommand}" CommandParameter="Development" />
                                <Button Content="Beban Berat" Style="{StaticResource NexusRibbonCommandButtonStyle}" Command="{x:Bind ViewModel.SwitchProfileCommand}" CommandParameter="HeavyWorkload" />
                                <Button Content="Hemat Daya" Style="{StaticResource NexusRibbonCommandButtonStyle}" Command="{x:Bind ViewModel.SwitchProfileCommand}" CommandParameter="PowerSaving" />
                                <Button Style="{StaticResource NexusRibbonCommandButtonStyle}" Command="{x:Bind ViewModel.RequestHideToTrayCommand}" ToolTipService.ToolTip="Sembunyikan ke System Tray (tetap berjalan di latar belakang)">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE921;" FontSize="11" />
                                        <TextBlock Text="Ke Tray" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="PROFIL OPTIMASI &amp; LATAR BELAKANG" FontSize="9" Foreground="{ThemeResource NexusTextMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Notifikasi Ribbon Ringkas -->
                        <TextBlock
                            Grid.Column="3"
                            Text="{x:Bind ViewModel.RibbonBannerMessage, Mode=OneWay}"
                            Style="{StaticResource NexusCaptionStyle}"
                            Foreground="{ThemeResource NexusAccentBrush}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Baris 2: Area Konten Halaman -->
        <Frame x:Name="ContentFrame" Grid.Row="2" NavigationFailed="ContentFrame_NavigationFailed" />

        <!-- Baris 3: Status Bar Telemetry Real-Time -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource NexusStatusBarBackgroundBrush}"
            BorderBrush="{ThemeResource NexusCardBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.StatusBarRamText, Mode=OneWay}" Style="{StaticResource NexusMutedCaptionStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusBarCpuText, Mode=OneWay}" Style="{StaticResource NexusMutedCaptionStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusBarSwapText, Mode=OneWay}" Style="{StaticResource NexusMutedCaptionStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusBarCountsText, Mode=OneWay}" Style="{StaticResource NexusMutedCaptionStyle}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.StatusBarGuardrailText, Mode=OneWay}"
                    Style="{StaticResource NexusMutedCaptionStyle}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
