<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinUI 3 & Windows App SDK (Empirically verified on .NET 10.0.401 + Win10 19045) -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />

    <!-- MVVM, Charting & System Tray -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.5" />
    <PackageVersion Include="H.NotifyIcon.WinUI" Version="2.4.1" />

    <!-- .NET 10 Extensions, Logging, Hosting & SQLite -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />

    <!-- Windows System Interop -->
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="10.0.15" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.15" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>

