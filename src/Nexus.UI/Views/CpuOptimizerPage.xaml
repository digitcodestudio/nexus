<Page
    x:Class="Nexus.UI.Views.CpuOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Nexus.UI.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="22,14,22,22" Spacing="14">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Optimasi CPU &amp; Mode Efisiensi (EcoQoS)" Style="{StaticResource NexusPageTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.GuardrailText, Mode=OneWay}" Style="{StaticResource NexusCaptionStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Kembalikan Semua EcoQoS" Command="{x:Bind ViewModel.RevertAllEcoQoSCommand}" />
                    <Button Content="Segarkan Analisa" Command="{x:Bind ViewModel.RefreshCommand}" />
                </StackPanel>
            </Grid>

            <!-- Status CPU & Mode Daya Windows -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource NexusCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Status Beban CPU" Style="{StaticResource NexusCardTitleStyle}" />
                        <ProgressBar Value="{x:Bind ViewModel.CpuUsagePercent, Mode=OneWay}" Maximum="100" Height="8" />
                        <TextBlock Text="{x:Bind ViewModel.CpuSummaryText, Mode=OneWay}" Style="{StaticResource NexusCaptionStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.EcoQoSCountText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource NexusAccentBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource NexusSuccessBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource NexusCardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Mode Daya Windows (Power Mode)" Style="{StaticResource NexusCardTitleStyle}" />
                        <TextBlock Text="Menggunakan API daya resmi Windows tanpa manipulasi voltase atau clock berbahaya." Style="{StaticResource NexusMutedCaptionStyle}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Hemat Daya" Command="{x:Bind ViewModel.SetPowerModeCommand}" CommandParameter="BestPowerEfficiency" />
                            <Button Content="Seimbang" Command="{x:Bind ViewModel.SetPowerModeCommand}" CommandParameter="Balanced" />
                            <Button Content="Performa Terbaik" Command="{x:Bind ViewModel.SetPowerModeCommand}" CommandParameter="BestPerformance" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Beban Kerja Latar Belakang -->
            <Border Style="{StaticResource NexusCardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Beban CPU Latar Belakang (Bukan Aplikasi Fokus Utama)" Style="{StaticResource NexusCardTitleStyle}" />
                    <TextBlock Text="Aplikasi yang sedang fokus atau sedang melakukan kompilasi/build tidak akan dicekik secara otomatis." Style="{StaticResource NexusMutedCaptionStyle}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.BackgroundConsumers}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:CpuConsumerRow">
                                <Grid Padding="8,8" BorderBrush="{ThemeResource NexusDividerBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource NexusTextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource NexusMutedCaptionStyle}">
                                        <Run Text="{x:Bind ProcessCount}" /><Run Text=" proses" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{x:Bind CpuText}" VerticalAlignment="Center" Style="{StaticResource NexusCaptionStyle}" Foreground="{ThemeResource NexusTextPrimaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind StatusText}" VerticalAlignment="Center" Style="{StaticResource NexusCaptionStyle}" />

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                                        <Button Content="Aktifkan EcoQoS" Padding="10,4" FontSize="11" Tag="{x:Bind}" Click="EnableEco_Click" />
                                        <Button Content="Normal" Padding="10,4" FontSize="11" Tag="{x:Bind}" Click="DisableEco_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

