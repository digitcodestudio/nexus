<Page
    x:Class="Nexus.UI.Views.ActivityHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Nexus.UI.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="22,14,22,18" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Riwayat Aktivitas &amp; Pemulihan (Rollback)" Style="{StaticResource NexusPageTitleStyle}" />
                <TextBlock Text="Seluruh perubahan profil, proses, dan snapshot konfigurasi layanan tercatat di SQLite." Style="{StaticResource NexusCaptionStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Segarkan Riwayat" VerticalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <!-- Snapshot Rollback Layanan -->
        <Border Grid.Row="1" Style="{StaticResource NexusCardBorderStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Snapshot Cadangan Layanan Windows (Rollback 1-Klik)" Style="{StaticResource NexusCardTitleStyle}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource NexusSuccessBrush}" FontSize="12" VerticalAlignment="Center" />
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ServiceBackups}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:BackupRow">
                            <Grid Padding="8,6" BorderBrush="{ThemeResource NexusDividerBrush}" BorderThickness="0,0,0,1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind ServiceName}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource NexusTextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind OriginalConfigText}" VerticalAlignment="Center" Style="{StaticResource NexusCaptionStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind StatusText}" VerticalAlignment="Center" Style="{StaticResource NexusMutedCaptionStyle}" />
                                <Button Grid.Column="3" Content="Kembalikan" Padding="10,4" FontSize="11" IsEnabled="{x:Bind CanRollback}" Tag="{x:Bind}" Click="Rollback_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Border>

        <!-- Log Aktivitas -->
        <Border Grid.Row="2" Style="{StaticResource NexusCardBorderStyle}" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Log Audit Aktivitas" Style="{StaticResource NexusCardTitleStyle}" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Activities}" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActivityRow">
                            <Grid Padding="8,6" BorderBrush="{ThemeResource NexusDividerBrush}" BorderThickness="0,0,0,1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="85" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind TimeLocal}" Style="{StaticResource NexusMutedCaptionStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind SeverityText}" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Module}" Style="{StaticResource NexusMutedCaptionStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Target}" Style="{StaticResource NexusCaptionStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Summary}" Style="{StaticResource NexusCaptionStyle}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>

