<Page
    x:Class="Nexus.UI.Views.MemoryOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Nexus.Models"
    xmlns:vm="using:Nexus.UI.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="22,14,22,22" Spacing="14">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Optimasi Memori (RAM)" Style="{StaticResource NexusPageTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.GuardrailText, Mode=OneWay}" Style="{StaticResource NexusCaptionStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Analisa Memori Sekarang" VerticalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" />
            </Grid>

            <!-- Status Tekanan RAM -->
            <Border Style="{StaticResource NexusCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.PressureStatusText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource NexusTextPrimaryBrush}" />
                    <ProgressBar Value="{x:Bind ViewModel.RamUsagePercent, Mode=OneWay}" Maximum="100" Height="8" />
                    <TextBlock Text="{x:Bind ViewModel.RamSummaryText, Mode=OneWay}" Style="{StaticResource NexusCaptionStyle}" />
                    <TextBlock Text="Prinsip Keamanan NEXUS: Tidak pernah melakukan flush RAM palsu secara massal ke semua proses. Optimasi fokus pada aplikasi latar belakang idle, grup browser (Chrome/Edge), dan kebocoran memori." Style="{StaticResource NexusMutedCaptionStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource NexusSuccessBrush}" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Aplikasi Konsumsi RAM Tertinggi -->
            <Border Style="{StaticResource NexusCardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Konsumsi RAM Tertinggi per Grup Aplikasi" Style="{StaticResource NexusCardTitleStyle}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.TopConsumers}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemoryConsumerRow">
                                <Grid Padding="8,8" BorderBrush="{ThemeResource NexusDividerBrush}" BorderThickness="0,0,0,1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource NexusTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind GroupKey}" Style="{StaticResource NexusMutedCaptionStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource NexusMutedCaptionStyle}">
                                        <Run Text="{x:Bind ProcessCount}" /><Run Text=" proses" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{x:Bind PrivateMemoryText}" VerticalAlignment="Center" Style="{StaticResource NexusCaptionStyle}" Foreground="{ThemeResource NexusTextPrimaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind IdleText}" VerticalAlignment="Center" Style="{StaticResource NexusMutedCaptionStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind StatusText}" VerticalAlignment="Center" Style="{StaticResource NexusCaptionStyle}" />

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                                        <Button Content="EcoQoS" Padding="10,4" FontSize="11" Tag="{x:Bind}" Click="ApplyEcoQoS_Click" />
                                        <Button Content="Optimasi Terarah" Padding="10,4" FontSize="11" Tag="{x:Bind}" Click="ApplyScopedTrim_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Rekomendasi & Dugaan Kebocoran Memori -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource NexusCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Rekomendasi Optimasi Aman" Style="{StaticResource NexusCardTitleStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recommendations}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:OptimizationRecommendation">
                                    <Border Background="{ThemeResource NexusCardElevatedBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource NexusTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource NexusMutedCaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource NexusCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Deteksi Tren Kebocoran Memori (Memory Leak)" Style="{StaticResource NexusCardTitleStyle}" />
                        <TextBlock Text="Memantau pertumbuhan RAM privat secara berkelanjutan. Proses yang terus naik tanpa pelepasan akan muncul di sini." Style="{StaticResource NexusMutedCaptionStyle}" TextWrapping="Wrap" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.LeakSuspects}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:MemoryLeakSuspect">
                                    <Border Background="{ThemeResource NexusWarningSubtleBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind ProcessName}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource NexusWarningBrush}" />
                                            <TextBlock Style="{StaticResource NexusMutedCaptionStyle}">
                                                <Run Text="Pertumbuhan: +" /><Run Text="{x:Bind GrowthMegabytesPerHour}" /><Run Text=" MB/jam" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

