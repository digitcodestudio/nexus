<Page
    x:Class="Nexus.UI.Views.ProcessManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Nexus.UI.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="22,14,22,18" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Manajer Aplikasi &amp; Proses Pintar" Style="{StaticResource NexusPageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource NexusCaptionStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Segarkan Daftar" VerticalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <!-- Bar Filter & Deteksi Idle -->
        <Border Grid.Row="1" Style="{StaticResource NexusCardBorderStyle}" Padding="14,10">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        PlaceholderText="Cari aplikasi (mis. Chrome, Code, PID)..."
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        IsOn="{x:Bind ViewModel.GroupByApplication, Mode=TwoWay}"
                        OnContent="Grup Aplikasi"
                        OffContent="Semua Proses" />

                    <ToggleSwitch
                        Grid.Column="2"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        IsOn="{x:Bind ViewModel.IdleOnlyFilter, Mode=TwoWay}"
                        OnContent="Kandidat Idle ≥ 30 mnt"
                        OffContent="Semua Status" />

                    <TextBlock
                        Grid.Column="3"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Foreground="{ThemeResource NexusAccentBrush}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Tabel Proses -->
        <Border Grid.Row="2" Style="{StaticResource NexusCardBorderStyle}" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="8,6" Background="{ThemeResource NexusCardElevatedBrush}" CornerRadius="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="0.6*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Aplikasi" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Instansi" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="RAM Privat" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Idle" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Aktivitas" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="Aksi Aman" Style="{StaticResource NexusCaptionStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Rows}"
                    SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProcessDisplayRow">
                            <Grid Padding="8,6" BorderBrush="{ThemeResource NexusDividerBrush}" BorderThickness="0,0,0,1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="250" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="Medium" Foreground="{ThemeResource NexusTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ProcessName}" Style="{StaticResource NexusMutedCaptionStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind InstanceText}" VerticalAlignment="Center" Style="{StaticResource NexusMutedCaptionStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind CpuText}" VerticalAlignment="Center" Style="{StaticResource NexusCaptionStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind MemoryText}" VerticalAlignment="Center" Style="{StaticResource NexusCaptionStyle}" Foreground="{ThemeResource NexusTextPrimaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind IdleText}" VerticalAlignment="Center" Style="{StaticResource NexusMutedCaptionStyle}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind ActivityText}" VerticalAlignment="Center" Style="{StaticResource NexusCaptionStyle}" />

                                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="Lindungi" Padding="8,3" FontSize="11" Tag="{x:Bind}" Click="ToggleProtect_Click" ToolTipService.ToolTip="Tambah/Hapus dari Whitelist Proteksi" />
                                    <Button Content="EcoQoS" Padding="8,3" FontSize="11" Tag="{x:Bind}" Click="EcoQoS_Click" ToolTipService.ToolTip="Aktifkan Mode Efisiensi Windows" />
                                    <Button Content="Tutup Halus" Padding="8,3" FontSize="11" Tag="{x:Bind}" Click="GracefulClose_Click" ToolTipService.ToolTip="Kirim WM_CLOSE (aman, tidak force-kill)" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>

