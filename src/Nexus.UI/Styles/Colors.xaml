<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="NexusWindowBackgroundBrush" Color="#0E1117" />
            <SolidColorBrush x:Key="NexusSidebarBackgroundBrush" Color="#12161E" />
            <SolidColorBrush x:Key="NexusCardBackgroundBrush" Color="#161B24" />
            <SolidColorBrush x:Key="NexusCardElevatedBrush" Color="#1C2330" />
            <SolidColorBrush x:Key="NexusCardBorderBrush" Color="#252D3B" />
            <SolidColorBrush x:Key="NexusDividerBrush" Color="#1F2633" />
            <SolidColorBrush x:Key="NexusStatusBarBackgroundBrush" Color="#10141C" />

            <SolidColorBrush x:Key="NexusTextPrimaryBrush" Color="#F0F4F8" />
            <SolidColorBrush x:Key="NexusTextSecondaryBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="NexusTextMutedBrush" Color="#64748B" />

            <SolidColorBrush x:Key="NexusAccentBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="NexusAccentSubtleBrush" Color="#1A4CC2FF" />
            <SolidColorBrush x:Key="NexusSuccessBrush" Color="#3FB950" />
            <SolidColorBrush x:Key="NexusSuccessSubtleBrush" Color="#1F3FB950" />
            <SolidColorBrush x:Key="NexusWarningBrush" Color="#D29922" />
            <SolidColorBrush x:Key="NexusWarningSubtleBrush" Color="#24D29922" />
            <SolidColorBrush x:Key="NexusCriticalBrush" Color="#F85149" />
            <SolidColorBrush x:Key="NexusCriticalSubtleBrush" Color="#26F85149" />
            <SolidColorBrush x:Key="NexusRingTrackBrush" Color="#252D3B" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NexusWindowBackgroundBrush" Color="#F3F5F8" />
            <SolidColorBrush x:Key="NexusSidebarBackgroundBrush" Color="#EAEFF5" />
            <SolidColorBrush x:Key="NexusCardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NexusCardElevatedBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="NexusCardBorderBrush" Color="#DCE3EC" />
            <SolidColorBrush x:Key="NexusDividerBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="NexusStatusBarBackgroundBrush" Color="#E6ECF3" />

            <SolidColorBrush x:Key="NexusTextPrimaryBrush" Color="#111827" />
            <SolidColorBrush x:Key="NexusTextSecondaryBrush" Color="#475569" />
            <SolidColorBrush x:Key="NexusTextMutedBrush" Color="#64748B" />

            <SolidColorBrush x:Key="NexusAccentBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="NexusAccentSubtleBrush" Color="#1A0067C0" />
            <SolidColorBrush x:Key="NexusSuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="NexusSuccessSubtleBrush" Color="#1F15803D" />
            <SolidColorBrush x:Key="NexusWarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="NexusWarningSubtleBrush" Color="#24B45309" />
            <SolidColorBrush x:Key="NexusCriticalBrush" Color="#B91C1C" />
            <SolidColorBrush x:Key="NexusCriticalSubtleBrush" Color="#24B91C1C" />
            <SolidColorBrush x:Key="NexusRingTrackBrush" Color="#E2E8F0" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>

